<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package -->
    <PackageId>XisfLib.Core</PackageId>
    <!-- Single source of truth for the version. This is the ONLY line to touch, and only
         when cutting a new major/minor. CI (publish.yml, on push to main) appends the
         patch as VersionPrefix.<github.run_number> and publishes automatically, so routine
         maintenance needs no version edit at all. The published version is tagged back to
         the repo. A plain local `dotnet pack` (no Version override) produces VersionPrefix.0 —
         fine for local testing. 1.2 marks the switch from manual version+tag releases;
         the prefix must stay >= 1.2 so run-number patches always sort above the last
         manually-published 1.1.3. -->
    <VersionPrefix>1.3</VersionPrefix>
    <Authors>Jonathan MacCollum</Authors>
    <Description>A .NET library for reading and writing XISF (Extensible Image Serialization Format) files</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JonathanMaccollum/XisfLib.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JonathanMaccollum/XisfLib.Core</RepositoryUrl>
    <PackageTags>xisf;astronomy;astrophotography;pixinsight;image</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/JonathanMaccollum/XisfLib.Core/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- The test project lives under Tests/ beside this one; the implicit globs must not pull its
       sources into the library. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
